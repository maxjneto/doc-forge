# DocForge — production environment for the VPS stack.
# Copy to the repo root as `.env` and fill in. NEVER commit the real .env
# (it is gitignored). `docker compose -f docker-compose.prod.yml` reads it.

# ── Domains / TLS ────────────────────────────────────────────────────────────
DOCFORGE_DOMAIN=docforge.example.com
DOCFORGE_MCP_DOMAIN=mcp.docforge.example.com
ACME_EMAIL=you@example.com

# ── Postgres (internal only — not exposed to the internet) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docforge
# DATABASE_URL is composed automatically by docker-compose.prod.yml from the
# three vars above; no need to set it here.

# ── Azure OpenAI (hosted guided/pipeline executor) ───────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_GUARDRAIL_DEPLOYMENT=gpt-4o-mini

# ── Inngest (self-hosted single node; keys secure the backend<->inngest link) ─
INNGEST_EVENT_KEY=generate-a-random-secret
INNGEST_SIGNING_KEY=generate-another-random-secret

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
CLERK_JWKS_URL=https://your-clerk-instance/.well-known/jwks.json
# Frontend (build-time; baked into the bundle):
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Stripe billing (leave STRIPE_ENABLED=false until price IDs are decided) ───
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# ── PostHog analytics (optional) ─────────────────────────────────────────────
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_REDACT_PROMPTS=true
# Frontend (build-time):
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

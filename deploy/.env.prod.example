# DocForge — production environment for the VPS stack.
# Copy to the repo root as `.env` and fill in. NEVER commit the real .env
# (it is gitignored). `docker compose -f docker-compose.prod.yml` reads it.

# ── Pre-built images (GHCR) ──────────────────────────────────────────────────
# Images are built by .github/workflows/build.yml and pushed to GHCR. The VPS
# only pulls them — it never builds. IMAGE_OWNER is your GitHub username/org
# (lowercase). Override IMAGE_TAG to pin a specific commit instead of latest.
IMAGE_OWNER=maxjneto
IMAGE_TAG=latest

# Which compose files `docker compose` (and the deploy workflow) use. On a VPS
# shared with another app whose Caddy owns 80/443 (the CopaSim box), add the
# colocated override; on a box of its own, keep only the production file.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.colocated.yml

# ── Domains / TLS ────────────────────────────────────────────────────────────
DOCFORGE_DOMAIN=doc-forge.dev
DOCFORGE_MCP_DOMAIN=mcp.doc-forge.dev
ACME_EMAIL=you@example.com

# ── Postgres (internal only — not exposed to the internet) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docforge
# DATABASE_URL is composed automatically by docker-compose.prod.yml from the
# three vars above; no need to set it here.

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
CLERK_JWKS_URL=https://your-clerk-instance/.well-known/jwks.json
# NOTE: VITE_CLERK_PUBLISHABLE_KEY is now a *GitHub Actions secret* (baked into
# the frontend image at build time by the GHCR workflow) — it is NOT read from
# this file on the VPS. Same for VITE_POSTHOG_KEY below.

# ── Stripe billing (leave STRIPE_ENABLED=false until price IDs are decided) ───
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# ── PostHog analytics (optional) ─────────────────────────────────────────────
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_KEY / VITE_POSTHOG_HOST: set as GitHub Actions secret/variable
# (build-time), not here.

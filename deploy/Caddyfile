# DocForge reverse proxy — automatic HTTPS via Let's Encrypt.
# Domains and ACME email come from the environment (see docker-compose.prod.yml).

{
	email {$ACME_EMAIL}
}

{$DOCFORGE_DOMAIN} {
	encode gzip zstd

	# API, SSE and the Inngest webhook all live under /api on the backend.
	handle /api/* {
		reverse_proxy backend:8000 {
			# SSE: don't buffer streamed responses.
			flush_interval -1
		}
	}

	# Everything else is the single-page app (nginx already falls back to
	# index.html for client-side routes).
	handle {
		reverse_proxy frontend:80
	}
}

# MCP streamable-HTTP server on its own subdomain.
{$DOCFORGE_MCP_DOMAIN} {
	encode gzip zstd
	reverse_proxy mcp:8001 {
		flush_interval -1
	}
}

# partiu — separate app, deployed independently from its own repo/compose
# project (../partiu). Only wired in here because this Caddy is the one
# process bound to 80/443 on the VPS; it never rebuilds or restarts when
# partiu redeploys, and vice-versa. Containers are reachable because both
# compose projects join the external `edge` network (see the `caddy`
# service's `networks:` in docker-compose.prod.yml).
#
# Update the hostname below to whatever DNS record you actually created —
# it does not need to be a subdomain of docforge's own domain.
webrole.copasim.com {
	handle /ws* {
		reverse_proxy webrole-signaling:8787
	}

	handle {
		reverse_proxy webrole-web:80
	}
}

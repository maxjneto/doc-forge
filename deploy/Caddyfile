# DocForge reverse proxy — automatic HTTPS via Let's Encrypt.
# Domains and ACME email come from the environment (see docker-compose.prod.yml).

{
	email {$ACME_EMAIL}
}

{$DOCFORGE_DOMAIN} {
	encode gzip zstd

	# The API and its SSE streams live under /api on the backend.
	handle /api/* {
		reverse_proxy backend:8000 {
			# SSE: don't buffer streamed responses.
			flush_interval -1
		}
	}

	# PostHog through our own domain: blockers that drop *.posthog.com would
	# otherwise erase a large part of a developer audience. The frontend is built
	# with VITE_POSTHOG_HOST=https://<domain>/ingest.
	handle_path /ingest/static/* {
		rewrite * /static{path}
		reverse_proxy https://us-assets.i.posthog.com:443 {
			header_up Host us-assets.i.posthog.com
		}
	}
	handle_path /ingest/* {
		reverse_proxy https://us.i.posthog.com:443 {
			header_up Host us.i.posthog.com
		}
	}

	# Everything else is the single-page app (nginx already falls back to
	# index.html for client-side routes).
	handle {
		reverse_proxy frontend:80
	}
}

# MCP streamable-HTTP server on its own subdomain.
{$DOCFORGE_MCP_DOMAIN} {
	encode gzip zstd
	reverse_proxy mcp:8001 {
		flush_interval -1
	}
}

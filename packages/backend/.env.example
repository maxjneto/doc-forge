# The Postgres of docker-compose.yml (`docker compose up -d postgres`). Inside the
# compose stack the backend gets its own DATABASE_URL; this one is for running
# the backend on your machine.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5480/docforge
# The layout service of docker-compose.yml (`docker compose up -d layout`).
LAYOUT_SERVICE_URL=http://127.0.0.1:8002

# Optional: Redis pub/sub for SSE fan-out across replicas (empty = in-process, replica=1)
REDIS_URL=
CLERK_JWKS_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
# Comma-separated list of allowed frontend origins (matches the `azp` JWT claim)
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]

# PostHog analytics (optional — leave POSTHOG_ENABLED=false to disable entirely)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false

# Document capacity per plan
FREE_WEEKLY_DOCUMENT_CREDITS=15
PRO_WEEKLY_DOCUMENT_CREDITS=100
FREE_MAX_ACTIVE_DOCUMENTS=30
PRO_MAX_ACTIVE_DOCUMENTS=1000
FREE_MAX_API_KEYS=2
PRO_MAX_API_KEYS=10
FREE_MAX_VERSIONS_PER_SECTION=50
# Shown on the pricing page; the charge is the Stripe price.
PRO_PRICE_MONTHLY_USD=4

# Stripe billing (optional — leave STRIPE_ENABLED=false until price points are decided).
# Use TEST-MODE keys (sk_test_..., whsec_test from the Stripe CLI or a test webhook
# endpoint, price_... test prices) until ready to go live.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing?checkout=cancel
